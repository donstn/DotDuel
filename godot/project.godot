; Engine configuration file.
config_version=5

[application]

config/name="DotDuel"
run/main_scene="res://scenes/main.tscn"
config/icon="res://assets/icon.png"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/quit_on_go_back=false
boot_splash/bg_color=Color(0.047, 0.114, 0.078, 1)
boot_splash/show_image=false
boot_splash/image="res://assets/icon.png"

[autoload]

Lang="*res://scripts/lang.gd"
Look="*res://scripts/look.gd"
Store="*res://scripts/store.gd"
Sfx="*res://scripts/sfx.gd"
Realtime="*res://scripts/net/realtime.gd"
Supa="*res://scripts/net/supa.gd"
Online="*res://scripts/net/online.gd"
Daily="*res://scripts/net/daily.gd"
Social="*res://scripts/net/social.gd"
Ach="*res://scripts/achievements.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=450
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.047, 0.114, 0.078, 1)
